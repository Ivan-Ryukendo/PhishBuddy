# PhishBuddy environment example
#
# Copy this file to `.env` for local values, and never commit real secrets.
# Both `.env` and `.env.local` are git-ignored. The local maintainer scripts
# load `.env.local` first, then `.env` (see scripts/env.mjs).
#
# IMPORTANT: The backend (Convex) reads provider keys and the maintainer token
# from its OWN deployment environment at runtime, NOT from these local files.
# Set those in Convex with `npx convex env set <NAME> <value>` or the Convex
# dashboard. The local files below are only for client/maintainer scripts and
# developer reference.

# --- Client / maintainer script configuration (local files) ---

# Convex HTTP Actions base URL the extension and scripts call.
# Example: https://your-deployment.convex.site
PHISHBUDDY_API_BASE_URL=https://your-convex-deployment.convex.site

# Authorizes trusted maintainers to update public domain labels via
# `npm run domains:upsert`. Use a long random value (length must be >= 16).
# Commonly placed in `.env.local`. Must MATCH the value set in the Convex
# deployment environment, or the backend will reject the request.
PHISHBUDDY_MAINTAINER_TOKEN=

# --- Backend provider keys (set these in the CONVEX deployment env) ---
# Listed here for reference. Leaving them blank locally is fine; the backend
# reports the provider as "skipped" when its key is not configured.

# Enables Google Safe Browsing provider checks.
GOOGLE_SAFE_BROWSING_API_KEY=

# Enables VirusTotal provider checks.
VIRUSTOTAL_API_KEY=

# --- Reserved / not currently read by the runtime ---
# The backend uses a 15-minute cache constant in convex/checkUrl.ts.
# This setting is kept as a documented placeholder only.
PHISHBUDDY_CACHE_TTL_SECONDS=900

# --- Convex CLI variables (auto-managed in .env.local) ---
# `npx convex dev` writes these into `.env.local` for you. Shown here so
# contributors know what to expect. Do not fill these in by hand unless you
# know the values for your own deployment.
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# CONVEX_URL=https://your-deployment.convex.cloud
# CONVEX_SITE_URL=https://your-deployment.convex.site
