{
  "manifest_version": 2,
  "name": "PhishBuddy",
  "version": "0.1.0",
  "description": "Checks navigations and pasted URLs with the PhishBuddy backend.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "src/config.js",
      "src/apiClient.js",
      "src/background.js"
    ]
  },
  "browser_action": {
    "default_title": "PhishBuddy",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  },
  "web_accessible_resources": [
    "warning.html",
    "warning.css",
    "src/ui.js",
    "src/warning.js"
  ]
}
